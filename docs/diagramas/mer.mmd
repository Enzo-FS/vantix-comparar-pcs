%% MER (modelo conceitual) da Vantix Tech Store, em notação de Chen:
%% retângulo = entidade · losango = relacionamento · número na linha = cardinalidade.
%% Relacionamentos N:N com dados próprios (carrinho_item, pedido_item, montagem_item, recomendacao)
%% aparecem como losango com os atributos entre parênteses.
flowchart LR
    PERFIL["PERFIL"]:::acesso
    USUARIO["USUÁRIO"]:::acesso
    CLIENTE["CLIENTE"]:::acesso
    ENDERECO["ENDEREÇO"]:::acesso
    CATEGORIA["CATEGORIA"]:::catalogo
    PRODUTO["PRODUTO"]:::catalogo
    ESTOQUE["ESTOQUE"]:::catalogo
    MOV["MOVIMENTAÇÃO<br/>DE ESTOQUE"]:::catalogo
    CARRINHO["CARRINHO"]:::compra
    PEDIDO["PEDIDO"]:::compra
    HIST["HISTÓRICO<br/>DE STATUS"]:::compra
    PAGAMENTO["PAGAMENTO"]:::compra
    ENTREGA["ENTREGA"]:::compra
    ESPEC["ESPECIFICAÇÃO<br/>TÉCNICA"]:::pc
    TARIFA["TARIFA DE<br/>ENERGIA"]:::pc
    MONTAGEM["MONTAGEM"]:::pc
    SOFTWARE["SOFTWARE"]:::pc
    REQUISITO["REQUISITO"]:::pc

    R1{"atribuído a"}:::rel
    R2{"é conta de"}:::rel
    R3{"cadastra"}:::rel
    R4{"agrupa"}:::rel
    R5{"tem saldo"}:::rel
    R6{"movimenta"}:::rel
    R7{"registra"}:::rel
    R8{"recomenda<br/>(tipo, peso)"}:::rel
    R9{"possui"}:::rel
    R10{"contém<br/>(quantidade)"}:::rel
    R11{"faz"}:::rel
    R12{"vira"}:::rel
    R13{"contém<br/>(quantidade,<br/>preço unitário)"}:::rel
    R14{"registra"}:::rel
    R15{"altera"}:::rel
    R16{"pago por"}:::rel
    R17{"entregue por"}:::rel
    R18{"entrega<br/>(entregador)"}:::rel
    R19{"destino de"}:::rel
    R20{"origina"}:::rel
    R21{"detalhado por"}:::rel
    R22{"salva"}:::rel
    R23{"usa tarifa<br/>da UF"}:::rel
    R24{"usa<br/>(quantidade)"}:::rel
    R25{"verificada no"}:::rel
    R26{"exige"}:::rel

    PERFIL -- 1 --- R1 -- N --- USUARIO
    USUARIO -- 0..1 --- R2 -- 0..1 --- CLIENTE
    CLIENTE -- 1 --- R3 -- N --- ENDERECO
    CATEGORIA -- 1 --- R4 -- N --- PRODUTO
    PRODUTO -- 1 --- R5 -- 1 --- ESTOQUE
    PRODUTO -- 1 --- R6 -- N --- MOV
    USUARIO -- 0..1 --- R7 -- N --- MOV
    PRODUTO -- N --- R8 -- N --- PRODUTO
    CLIENTE -- 0..1 --- R9 -- N --- CARRINHO
    CARRINHO -- N --- R10 -- N --- PRODUTO
    CLIENTE -- 1 --- R11 -- N --- PEDIDO
    CARRINHO -- 0..1 --- R12 -- 0..1 --- PEDIDO
    PEDIDO -- N --- R13 -- N --- PRODUTO
    PEDIDO -- 1 --- R14 -- 1..N --- HIST
    USUARIO -- 0..1 --- R15 -- N --- HIST
    PEDIDO -- 1 --- R16 -- 1 --- PAGAMENTO
    PEDIDO -- 1 --- R17 -- 1 --- ENTREGA
    USUARIO -- 0..1 --- R18 -- N --- ENTREGA
    ENDERECO -- 0..1 --- R19 -- N --- ENTREGA
    PEDIDO -- 0..1 --- R20 -- N --- MOV
    PRODUTO -- 1 --- R21 -- 0..1 --- ESPEC
    CLIENTE -- 0..1 --- R22 -- N --- MONTAGEM
    TARIFA -- 1 --- R23 -- N --- MONTAGEM
    MONTAGEM -- N --- R24 -- N --- PRODUTO
    MONTAGEM -- 0..1 --- R25 -- N --- PEDIDO
    SOFTWARE -- 1 --- R26 -- 1..3 --- REQUISITO

    classDef acesso fill:#dbe6fe,stroke:#1d5bd6,stroke-width:2.5px,color:#0b1b3f,font-weight:bold
    classDef catalogo fill:#dcfce7,stroke:#15803d,stroke-width:2.5px,color:#0b1b3f,font-weight:bold
    classDef compra fill:#fef3c7,stroke:#b45309,stroke-width:2.5px,color:#0b1b3f,font-weight:bold
    classDef pc fill:#ede9fe,stroke:#6d28d9,stroke-width:2.5px,color:#0b1b3f,font-weight:bold
    classDef rel fill:#ffffff,stroke:#475569,stroke-width:1.5px,color:#334155
